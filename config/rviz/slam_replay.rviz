Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /SLAM Map1
        - /Original ICP Path1
        - /Corrected SLAM Path1
        - /Current Pose1
        - /Keyframes1
        - /Loop Edges1
      Splitter Ratio: 0.55
    Tree Height: 650

  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5

Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 20
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: SLAM Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.04
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/map
      Use Fixed Frame: true
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 170; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: Original ICP Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 170; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/original_path
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 80
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.14
      Name: Corrected SLAM Path
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 0; 255; 80
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/corrected_path
      Value: true

    - Alpha: 1
      Axes Length: 1
      Axes Radius: 0.1
      Class: rviz_default_plugins/Pose
      Color: 255; 40; 40
      Enabled: true
      Head Length: 0.5
      Head Radius: 0.25
      Name: Current Pose
      Shaft Length: 1
      Shaft Radius: 0.1
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/current_pose
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Keyframes
      Namespaces:
        slam_keyframes: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/keyframes
      Value: true

    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Loop Edges
      Namespaces:
        slam_loop_edges: true
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /slam/loop_edges
      Value: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true

  Enabled: true

  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom_lidar
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact

    - Class: rviz_default_plugins/MoveCamera

    - Class: rviz_default_plugins/Select

    - Class: rviz_default_plugins/FocusCamera

    - Class: rviz_default_plugins/Measure

  Transformation:
    Current:
      Class: rviz_default_plugins/TF

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 180
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.785398
      Focal Point:
        X: 80
        Y: 40
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.1
      Target Frame: odom_lidar
      Value: Orbit (rviz)

Window Geometry:
  Displays:
    collapsed: false

  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true

  Width: 1500
  X: 50
  Y: 50
